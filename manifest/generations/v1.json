{
  "$schema": "../schema.json",
  "generation": "v1",
  "baseUrl": "https://api.aryeo.com/v1",
  "auth": {
    "scheme": "bearer",
    "header": "Authorization"
  },
  "defaults": {
    "perPage": 100,
    "perPageMax": 100,
    "filterStyle": "bracketed",
    "enumCase": "lower"
  },
  "operations": {
    "appointments.availability.get": {
      "path": "/appointments/{appointmentId}/availability",
      "method": "GET",
      "summary": "Whether a given team member can take this appointment at a given length.",
      "availability": {
        "state": "available"
      },
      "pathParams": {
        "appointmentId": {
          "type": "uuid",
          "required": true
        }
      },
      "params": {
        "assignee_id": {
          "type": "uuid",
          "required": true
        },
        "duration": {
          "type": "integer",
          "required": true,
          "units": "minutes"
        }
      },
      "quirks": [
        "Returns a single flag, has_conflicts."
      ],
      "evidence": {
        "file": "2026-08-29-appointments.json",
        "date": "2026-08-29"
      }
    },
    "appointments.cancel": {
      "path": "/appointments/{appointmentId}/cancel",
      "method": "POST",
      "availability": {
        "state": "unverified",
        "note": "CONFLICT: production code in the Envesko estate uses POST here, while an earlier MCP implementation used PUT. Neither has been confirmed against a live cancellation. Resolve before generating this method."
      },
      "mutates": true,
      "confirmation": {
        "kind": "echoIdentifier",
        "field": "number",
        "warns": "Cancels the appointment in Aryeo. Anybody holding that slot is told it is gone."
      },
      "pathParams": {
        "appointmentId": {
          "type": "uuid",
          "required": true
        }
      },
      "body": {
        "reason": {
          "type": "string",
          "max": 500
        },
        "notify_customer": {
          "type": "boolean",
          "default": true
        }
      },
      "evidence": {
        "file": "2026-08-29-writes.json",
        "date": "2026-08-29",
        "source": "production"
      }
    },
    "appointments.create": {
      "path": "/appointments/store",
      "method": "POST",
      "summary": "Books an appointment against an existing order.",
      "availability": {
        "state": "unverified",
        "note": "Described from production code. Not exercised from this repository, because booking one puts a real slot in somebody's calendar."
      },
      "mutates": true,
      "confirmation": {
        "kind": "echoIdentifier",
        "field": "number",
        "warns": "Creates a real appointment. The customer is notified unless notify_customer is false."
      },
      "body": {
        "order_id": {
          "type": "uuid",
          "required": true
        },
        "start_at": {
          "type": "datetime",
          "required": true
        },
        "end_at": {
          "type": "datetime",
          "required": true,
          "note": "Required. A duration field is accepted and silently discarded, so sending duration alone books nothing."
        },
        "notify_customer": {
          "type": "boolean",
          "default": true
        }
      },
      "quirks": [
        "Aryeo stores whatever span it is given and does not derive length from the order's products, so the caller owns the number.",
        "The order must already carry an address or the booking is refused."
      ],
      "evidence": {
        "file": "2026-08-29-writes.json",
        "date": "2026-08-29",
        "source": "production"
      }
    },
    "appointments.get": {
      "path": "/appointments/{appointmentId}",
      "method": "GET",
      "availability": {
        "state": "available"
      },
      "pathParams": {
        "appointmentId": {
          "type": "uuid",
          "required": true
        }
      },
      "quirks": [
        "Carries can_cancel, can_reschedule and the lock period flags. Read them before attempting either mutation."
      ],
      "evidence": {
        "file": "2026-08-29-appointments.json",
        "date": "2026-08-29"
      }
    },
    "appointments.list": {
      "path": "/appointments",
      "method": "GET",
      "availability": {
        "state": "available"
      },
      "paginated": true,
      "perPageMax": 100,
      "filters": {
        "startAtGte": {
          "wire": "filter[start_at_gte]",
          "state": "honoured",
          "type": "datetime",
          "evidence": {
            "file": "2026-08-29-appointments.json",
            "date": "2026-08-29",
            "measurement": "66 of 5422 over 7 days"
          }
        },
        "startAtLte": {
          "wire": "filter[start_at_lte]",
          "state": "honoured",
          "type": "datetime",
          "evidence": {
            "file": "2026-08-29-appointments.json",
            "date": "2026-08-29",
            "measurement": "66 of 5422 over 7 days"
          }
        },
        "search": {
          "wire": "filter[search]",
          "state": "honoured",
          "type": "string",
          "evidence": {
            "file": "2026-08-29-appointments.json",
            "date": "2026-08-29",
            "measurement": "3 of 5422"
          }
        },
        "status": {
          "state": "ignored",
          "type": "string",
          "strategy": "client-side",
          "note": "filter[status] and filter[appointment_status] both return the full collection.",
          "evidence": {
            "file": "2026-08-29-appointments.json",
            "date": "2026-08-29",
            "measurement": "5422 of 5422, unchanged"
          }
        },
        "orderId": {
          "state": "ignored",
          "type": "uuid",
          "strategy": "unsupported",
          "useInstead": "orders.get",
          "note": "Read the order with include=appointments instead. Exact, one request, no scan."
        },
        "tense": {
          "state": "rejected",
          "http": 422,
          "note": "The selected filter.tense is invalid, for every value tried."
        }
      },
      "includes": [
        "order",
        "order.address",
        "order.customer",
        "order.customerGroup",
        "order.customerTeamMembership",
        "order.listing",
        "order.items",
        "order.items.appointment",
        "order.tags",
        "owner",
        "users",
        "items",
        "company",
        "companyTeamMembers",
        "companyTeamMembers.user",
        "appointment_attendances",
        "appointment_attendances.company_team_member"
      ],
      "responseEnums": {
        "status": [
          "SCHEDULED",
          "UNSCHEDULED",
          "CANCELED"
        ]
      },
      "quirks": [
        "The date filters are start_at_gte and start_at_lte. The orders spelling appointment_start_at_gte is accepted here and ignored.",
        "start_at is stored in UTC. A local calendar day must be converted to instants before filtering or the window lands hours out.",
        "The assigned photographer is users or companyTeamMembers. There is no customer, listing or address include; those are under order."
      ],
      "evidence": {
        "file": "2026-08-29-appointments.json",
        "date": "2026-08-29"
      }
    },
    "appointments.reschedule": {
      "path": "/appointments/{appointmentId}/reschedule",
      "method": "PUT",
      "summary": "Moves an appointment to a new start, keeping its length.",
      "availability": {
        "state": "unverified",
        "note": "Described from production code. The method is PUT here while cancellation is POST; both are unconfirmed. See BLOCKERS.md."
      },
      "mutates": true,
      "confirmation": {
        "kind": "echoIdentifier",
        "field": "number",
        "warns": "Moves a real appointment. Anybody holding the old slot is told it has changed."
      },
      "pathParams": {
        "appointmentId": {
          "type": "uuid",
          "required": true
        }
      },
      "body": {
        "start_at": {
          "type": "datetime",
          "required": true
        },
        "notify_customer": {
          "type": "boolean",
          "default": true
        }
      },
      "quirks": [
        "Takes no duration. To change how long a shoot runs, cancel and rebook.",
        "Read can_reschedule and the lock period flags from appointments.get first."
      ],
      "evidence": {
        "file": "2026-08-29-writes.json",
        "date": "2026-08-29",
        "source": "production"
      }
    },

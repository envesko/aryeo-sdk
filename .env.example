# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Nothing in this repository reads these automatically. They are consumed by
# the probe tool when you point it at an account, and their CI equivalents are
# repository secrets, not files.

# ---------------------------------------------------------------------------
# Probing an Aryeo account
# ---------------------------------------------------------------------------

# A read-only-in-practice Aryeo API token. The probe tool issues GET requests
# only, and will refuse to run against any operation the manifest marks as
# mutating. Prefer an account with real volume: behaviour on forty records
# tells you very little about behaviour on five thousand.
ARYEO_API_TOKEN=

# Optional label recorded in the evidence file so a future reader knows what
# kind of account produced the numbers. Never put a customer or company name
# here; evidence/ is public.
# One of: enterprise | standard | sandbox
ARYEO_ACCOUNT_KIND=enterprise

# ---------------------------------------------------------------------------
# Publishing
# ---------------------------------------------------------------------------
# These belong in GitHub repository secrets for CI. They are listed here only
# so a local publish is possible while the release workflow is being built.

# npm automation token, from npmjs.com, Access Tokens, type "Automation".
# Needs publish rights on the @envesko scope.
NPM_TOKEN=

# Packagist updates via a GitHub service hook and needs no token here.
# If you ever script an update instead, these are the two values it wants.
PACKAGIST_USERNAME=
PACKAGIST_API_TOKEN=

# ---------------------------------------------------------------------------
# PHP mirror
# ---------------------------------------------------------------------------

# A token that can push to the read-only mirror repository the PHP package is
# split out to on tag. Needs contents write on that repo and nothing else.
MIRROR_PUSH_TOKEN=

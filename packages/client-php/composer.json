{
  "name": "envesko/aryeo-php",
  "description": "Typed PHP client for the Aryeo real estate media platform.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Envesko"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "autoload": {
    "psr-4": {
      "Envesko\\Aryeo\\": "src/"
    },
    "files": [
      "src/Exceptions.php"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}

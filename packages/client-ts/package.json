{
  "name": "@envesko/aryeo-client",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the Aryeo real estate media platform.",
  "license": "MIT",
  "author": "Envesko",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/envesko/aryeo-sdk.git",
    "directory": "packages/client-ts"
  },
  "keywords": [
    "aryeo",
    "real-estate",
    "api",
    "client",
    "sdk",
    "typescript"
  ],
  "homepage": "https://github.com/envesko/aryeo-sdk#readme",
  "bugs": {
    "url": "https://github.com/envesko/aryeo-sdk/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false
}

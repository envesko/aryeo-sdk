{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "replace-with-your-own-worker-name",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	"workers_dev": false,
	"preview_urls": false,
	"vars": { "OAUTH_CODE_STORE": "atomic" },
	// Create your own and paste the id here:
	//   wrangler kv namespace create OAUTH_KV
	//
	// It holds registered clients and hashed access tokens. Authorization codes
	// are kept in the OAUTH_CODES Durable Object.
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "replace-with-your-own-namespace-id"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "OAUTH_CODES", "class_name": "AuthorizationCodes" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["AuthorizationCodes"] }],
	// Example namespace IDs only. Replace each with an unused ID after checking
	// the account: sharing an ID between Workers can share rate-limit counters.
	"unsafe": {
		"bindings": [
			{ "name": "RATE_LIMIT_APPROVE", "type": "ratelimit", "namespace_id": "900001", "simple": { "limit": 5, "period": 60 } },
			{ "name": "RATE_LIMIT_REGISTER", "type": "ratelimit", "namespace_id": "900002", "simple": { "limit": 10, "period": 60 } },
			{ "name": "RATE_LIMIT_TOKEN", "type": "ratelimit", "namespace_id": "900003", "simple": { "limit": 10, "period": 60 } }
		]
	},
	// Both are secrets, set with `wrangler secret put`, never in this file:
	//   ARYEO_API_TOKEN     the Aryeo key this deployment acts with
	//   MCP_APPROVAL_CODE   what you paste in the browser to approve a client
	"observability": {
		"enabled": true
	}
}
